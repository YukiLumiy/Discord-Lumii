{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["DATABASE_URL", "DIRECT_URL", "DISCORD_TOKEN", "DISCORD_CLIENT_ID"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
