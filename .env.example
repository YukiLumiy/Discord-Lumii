# ルート直下の .env は Bot (apps/bot) が読み込みます。
# `cp .env.example .env` してから値を入力してください。(.env は絶対にGitへコミットしない)
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id

# 開発中はテストサーバー1つだけにコマンドを即時反映できます。
# 空欄の場合はグローバル登録(反映まで最大1時間)。
DEV_GUILD_ID=

# Neonの「Pooled connection」(ホスト名に -pooler が付く方)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
